programa
{
	
	funcao inicio()
	{
		//Inteiros - 1 2 3 4 5 6 99 12345
		//Reais - 1.0 2.2 99.9 3459867.4345
		//cadeia (Texto,string) - "olá mundo"
		//Lógico - verdadeiro ou falso 
		//Caracter - 'O' 'L' '8' '?' '-' '!' '@' (ITENS ÚNICOS)

		//OPERADORES ARITMETICOS 
		//+  -> SOMA
		//-  -> SUBTRAÇÃO
		//*  -> MULTIPLICAÇÃO 
		// / -> DIVISÃO
		//% -> MÓDULO (RESTO DA DIVISÃO)
		// () -> ALTERA A ORDEM DA OPERAÇÃO
		//* / -> + - -> PRECEDENCIA DE OPERADORES 
		escreva((25.5 * 3.5 - 3.5*3.5)/(40.5-4.5))
	}
}
